# Direct / stdio credentials, and HTTP only when AUTH_MODE is not gateway.
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
IMMYBOT_INSTANCE_SUBDOMAIN=
IMMYBOT_TENANT_ID=
IMMYBOT_CLIENT_ID=
IMMYBOT_CLIENT_SECRET=

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address for HTTP. When CONDUIT_S2S_SECRET is unset, the insecure-dev
# bypass binds 127.0.0.1 only. When a real secret is set, an unset
# MCP_HTTP_HOST binds 0.0.0.0 (the previous listen(port) behavior). The
# container image and Compose set 0.0.0.0 explicitly.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, secret,
# replace-with-a-real-secret, and similar). Generate a value with:
#   openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1. A non-loopback MCP_HTTP_HOST refuses to start.
# A placeholder CONDUIT_S2S_SECRET still refuses to start. Unset the secret
# to use this bypass. Do not use in production.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP. gateway (Docker image and Compose default)
# requires x-immybot-instance-subdomain, x-immybot-tenant-id,
# x-immybot-client-id, and x-immybot-client-secret on each /mcp request and
# never falls back to IMMYBOT_* env vars. Any other value is direct mode:
# those variables are used after X-Gateway-S2S verifies. Stdio ignores this.
# AUTH_MODE=gateway

# LOG_LEVEL=info
