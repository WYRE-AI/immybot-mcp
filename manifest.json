{
  "name": "@wyre-ai/immybot-mcp",
  "description": "MCP server for ImmyBot - Windows endpoint management and software deployment automation",
  "version": "1.0.0",
  "author": "WYRE Technology",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/WYRE-AI/immybot-mcp.git"
  },
  "capabilities": {
    "tools": {
      "description": "Comprehensive ImmyBot API integration with navigation-based tool discovery"
    }
  },
  "domains": [
    {
      "name": "computers",
      "description": "Device and endpoint management",
      "tools": [
        "immybot_computers_list",
        "immybot_computers_get",
        "immybot_computers_search",
        "immybot_computers_inventory",
        "immybot_computers_create",
        "immybot_computers_deployments",
        "immybot_computers_trigger_checkin"
      ]
    },
    {
      "name": "software",
      "description": "Application and package management",
      "tools": [
        "immybot_software_list_global",
        "immybot_software_list",
        "immybot_software_get",
        "immybot_software_search",
        "immybot_software_versions",
        "immybot_software_latest_version",
        "immybot_software_categories",
        "immybot_software_publishers",
        "immybot_software_install",
        "immybot_software_stats"
      ]
    }
  ],
  "navigation": {
    "type": "decision-tree",
    "tools": [
      "immybot_navigate",
      "immybot_status",
      "immybot_back"
    ]
  },
  "authentication": {
    "type": "oauth2-client-credentials",
    "provider": "Microsoft Entra ID",
    "scope": "api://{client_id}/.default",
    "required_credentials": [
      "instanceSubdomain",
      "tenantId",
      "clientId",
      "clientSecret"
    ]
  },
  "deployment": {
    "docker": {
      "image": "ghcr.io/wyre-ai/immybot-mcp",
      "ports": ["8080"],
      "environment": {
        "AUTH_MODE": "gateway",
        "MCP_TRANSPORT": "http",
        "MCP_HTTP_PORT": "8080",
        "MCP_HTTP_HOST": "0.0.0.0",
        "LOG_LEVEL": "info"
      }
    }
  },
  "documentation": {
    "readme": "https://github.com/WYRE-AI/immybot-mcp#readme",
    "api": "https://docs.immy.bot/reference/api-documentation/",
    "setup": "https://docs.immy.bot/integrations/build-your-own-integration/"
  }
}